  {% comment %} ---------- HEADER (Absolute Position) ---------- {% endcomment %}
  <div style="position: absolute; top: 12px; left: 16px; right: 16px; height: 42px; border-bottom: 3px solid black; display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 4px;">
    
    <div style="display: flex; align-items: baseline; gap: 10px;">
      <span style="font-weight: 900; font-size: 26px; line-height: 1;">{{ airport }}</span>
      <span style="font-size: 14px; font-weight: 700;">AIRSPACE CROSS-SECTION</span>
    </div>

    <div style="display: flex; gap: 16px; text-align: right;">
      <div>
        <span style="font-size: 10px; font-weight: 700; display: block; line-height: 1;">TARGETS</span>
        <span style="font-size: 20px; font-weight: 900; line-height: 1;">{{ ac_count }}</span>
      </div>
      <div>
        <span style="font-size: 10px; font-weight: 700; display: block; line-height: 1;">UPDATED</span>
        <span style="font-size: 20px; font-weight: 900; line-height: 1;">{{ time_stamp }}</span>
      </div>
    </div>
  </div>

  {% comment %} ---------- MAIN GRAPH BOX (Absolute Constraints) ---------- {% endcomment %}
  <div style="position: absolute; top: 68px; bottom: 42px; left: 56px; right: 16px; border-left: 3px solid black; border-bottom: 3px solid black;">
    
    {% if xs and flight_data and flight_data.size > 0 %}
      
      {% comment %} 1. SVG BACKGROUND LAYER (Lines, Grid, Ground) {% endcomment %}
      <svg width="100%" height="100%" viewBox="0 0 {{ xs.w }} {{ xs.h }}" preserveAspectRatio="none" style="position: absolute; inset: 0; overflow: visible;">
        
        {% comment %} Y-Axis Grid Lines {% endcomment %}
        {% for t in xs.ticks %}
          <line x1="0" y1="{{ t.y }}" x2="{{ xs.w }}" y2="{{ t.y }}" stroke="#888" stroke-width="{% if t.major %}1.5{% else %}1{% endif %}" stroke-dasharray="{% if t.major %}none{% else %}2 4{% endif %}" vector-effect="non-scaling-stroke"/>
        {% endfor %}
        
        {% comment %} X-Axis Grid Lines {% endcomment %}
        {% for t in xs.xticks %}
          <line x1="{{ t.x }}" y1="0" x2="{{ t.x }}" y2="{{ xs.h }}" stroke="#888" stroke-width="1" stroke-dasharray="2 4" vector-effect="non-scaling-stroke"/>
        {% endfor %}

        {% comment %} Class A / FL180 Line {% endcomment %}
        {% if xs.class_a_y %}
          <line x1="0" y1="{{ xs.class_a_y }}" x2="{{ xs.w }}" y2="{{ xs.class_a_y }}" stroke="#000" stroke-width="1.2" stroke-dasharray="9 5" vector-effect="non-scaling-stroke"/>
          <text x="{{ xs.w | minus: 3 }}" y="{{ xs.class_a_y | minus: 4 }}" font-size="9" font-weight="800" text-anchor="end" fill="black">FL180 / CLASS A</text>
        {% endif %}

        {% comment %} Ground Segment {% endcomment %}
        <rect x="0" y="{{ xs.ground_y }}" width="{{ xs.w }}" height="{{ xs.h | minus: xs.ground_y }}" fill="url(#hatch)"/>
        <line x1="0" y1="{{ xs.ground_y }}" x2="{{ xs.w }}" y2="{{ xs.ground_y }}" stroke="#000" stroke-width="3" vector-effect="non-scaling-stroke"/>

        {% comment %} Leader Lines Connecting Tag to Icon {% endcomment %}
        {% for f in flight_data %}{% if f.xs and f.xs_lead %}
          <line x1="{{ f.xs_x }}" y1="{{ f.xs_y }}" x2="{{ f.xs_lx }}" y2="{{ f.xs_ly }}" stroke="#000" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
        {% endif %}{% endfor %}
      </svg>

      {% comment %} 2. HTML AXIS LABELS {% endcomment %}
      {% for t in xs.ticks %}
        {% assign y_pct = t.y | times: 100.0 | divided_by: h_tot %}
        <div style="position: absolute; right: 100%; top: {{ y_pct }}%; margin-right: 8px; transform: translateY(-50%); font-size: 13px; font-weight: 700; white-space: nowrap;">
          {{ t.label }}
        </div>
      {% endfor %}

      {% for t in xs.xticks %}
        {% assign x_pct = t.x | times: 100.0 | divided_by: w_tot %}
        <div style="position: absolute; top: 100%; left: {{ x_pct }}%; margin-top: 6px; transform: translateX(-50%); font-size: 13px; font-weight: 700; white-space: nowrap;">
          {{ t.label }}
        </div>
      {% endfor %}

      {% comment %} 3. HTML AIRCRAFT ICONS & TAGS (Preserves exact shape without SVG stretch distortion) {% endcomment %}
      {% for f in flight_data %}{% if f.xs %}
        
        {% assign x_pct = f.xs_x | times: 100.0 | divided_by: w_tot %}
        {% assign y_pct = f.xs_y | times: 100.0 | divided_by: h_tot %}
        {% assign tag_x_pct = f.xs_tag_l | times: 100.0 | divided_by: w_tot %}
        {% assign tag_y_pct = f.xs_tag_t | times: 100.0 | divided_by: h_tot %}

        {% comment %} Aircraft Icon {% endcomment %}
        <div style="position: absolute; left: {{ x_pct }}%; top: {{ y_pct }}%; width: {{ f.icon_w }}px; height: {{ f.icon_h }}px; transform: translate(-50%, -50%) rotate({{ f.xs_rot }}deg); z-index: 5;">
          <svg width="100%" height="100%" style="overflow:visible;">
            <circle cx="50%" cy="50%" r="{{ f.icon_r }}" fill="white" />
            <use href="#s-{{ f.icon }}" fill="{% if f.is_airline %}#000{% else %}#fff{% endif %}" stroke="#000" stroke-width="{{ f.icon_sw }}"/>
          </svg>
        </div>

        {% comment %} Data Tag {% endcomment %}
        <div style="position: absolute; left: {{ tag_x_pct }}%; top: {{ tag_y_pct }}%; width: {{ f.xs_tag_w }}px; height: {{ f.xs_tag_h }}px; background: white; border: {% if f.xs_tag_big %}2px{% else %}1px{% endif %} solid black; border-radius: {% if f.xs_tag_big %}4px{% else %}2px{% endif %}; {% if f.xs_tag_dash %}border-style: dashed;{% endif %} display: flex; flex-direction: column; justify-content: center; padding-left: 6px; box-sizing: border-box; font-family: 'Courier New', Courier, monospace; line-height: 1.1; z-index: 10;">
          
          <div style="display: flex; gap: 4px; align-items: baseline;">
            <span style="font-weight: 900; font-size: {{ f.xs_fs1 }}px;">{{ f.xs_l1a }}</span>
            {% if f.xs_l1b != "" %}<span style="font-weight: 700; font-size: {{ f.xs_fs1b }}px;">{{ f.xs_l1b }}</span>{% endif %}
          </div>
          
          <div style="display: flex; gap: 2px; align-items: center; font-size: {{ f.xs_fs2 }}px; font-weight: 700;">
            <span>{{ f.xs_l2a }}</span>
            {% if f.xs_trend != "" %}
              <span style="font-size: {{ f.xs_fs2 | minus: 1 }}px; margin-top: 1px;">
                {% if f.xs_trend == 'up' %}&#9650;{% else %}&#9660;{% endif %}
              </span>
            {% endif %}
            <span>{{ f.xs_l2b }}</span>
          </div>
          
          {% if f.xs_l3 != "" %}
            <div style="font-size: {{ f.xs_fs3 }}px; font-weight: 700;">{{ f.xs_l3 }}</div>
          {% endif %}
          
        </div>

      {% endif %}{% endfor %}

      {% comment %} Airport Tower Icon {% endcomment %}
      {% assign twx_pct = xs.airport_x | times: 100.0 | divided_by: w_tot %}
      {% assign twy_pct = xs.ground_y | times: 100.0 | divided_by: h_tot %}
      <div style="position: absolute; left: {{ twx_pct }}%; top: {{ twy_pct }}%; width: 26px; height: 26px; transform: translate(-50%, -100%);">
         <svg width="100%" height="100%" viewBox="-45 -50 730 587"><use href="#s-ground_tower" fill="#000"/></svg>
      </div>

    {% else %}
      <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column;">
        <span style="font-size: 24px; font-weight: 900; background: white; padding: 6px 16px; border: 3px solid black;">{% if error %}DATA ERROR{% else %}NO TARGETS IN RANGE{% endif %}</span>
        {% if error %}<span style="margin-top: 8px; font-size: 14px; font-weight: 600;">{{ error | escape }}</span>{% endif %}
      </div>
    {% endif %}

  </div>

  {% comment %} ---------- FOOTER / LEGEND (Absolute Position) ---------- {% endcomment %}
  <div style="position: absolute; bottom: 8px; left: 16px; right: 16px; display: flex; justify-content: space-between; align-items: center;">
    
    <div style="display: flex; gap: 16px; font-size: 11px; font-weight: 700;">
      <span style="display: flex; align-items: center; gap: 4px;"><svg width="16" height="16" viewBox="-10 -10 380 415" style="transform: rotate(90deg);"><use href="#s-a320" fill="#000"/></svg> AIRLINE</span>
      <span style="display: flex; align-items: center; gap: 4px;"><svg width="16" height="16" viewBox="0 -1 32 31" style="transform: rotate(90deg);"><use href="#s-cessna" fill="#fff" stroke="#000" stroke-width="2"/></svg> GA/OTHER</span>
      <span style="display: flex; align-items: center; gap: 4px;"><div style="width: 14px; height: 10px; border: 1.5px dashed black; border-radius: 2px;"></div> MIL</span>
    </div>
    
    <div style="display: flex; gap: 16px; font-size: 11px; font-weight: 700;">
      <span>&#9650; CLIMB</span>
      <span>&#9660; DESC</span>
      <span>0-10NM{% if xs.low_share == 45 %} / 0-10K{% endif %} EXPANDED</span>
    </div>

  </div>
</div>
